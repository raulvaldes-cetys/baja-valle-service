NODE_ENV=development
PORT=3000

# Rol sin DDL
DATABASE_URL=postgresql://baja_valle_app:app_local@127.0.0.1:5432/baja_valle
# Dueño de las tablas, para migraciones
DIRECT_URL=postgresql://baja_valle_migrator:migrator_local@127.0.0.1:5432/baja_valle

# Separados por coma
CORS_ORIGINS=http://localhost:4321

SWAGGER_ENABLED=true

MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_TO=
