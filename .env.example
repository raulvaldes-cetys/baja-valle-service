# Copia este archivo a .env. Nunca subas .env al repo.
# Valores por defecto: Postgres local de docker-compose (`pnpm db:up`).

NODE_ENV=development
PORT=3000

# Runtime de la API: rol con solo DML (baja_valle_app)
DATABASE_URL=postgresql://baja_valle_app:app_local@127.0.0.1:5432/baja_valle
# Migraciones: rol dueño de las tablas (baja_valle_migrator)
DIRECT_URL=postgresql://baja_valle_migrator:migrator_local@127.0.0.1:5432/baja_valle

# Orígenes permitidos por CORS, separados por coma. Vacío = ninguno (la app móvil no usa CORS)
CORS_ORIGINS=http://localhost:4321

# Swagger en /docs. Apagado por defecto; solo encenderlo en local
SWAGGER_ENABLED=true

# SMTP para correos de contacto y cotización
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_TO=
