# Alerta cuando un mismo cliente recibe 3 respuestas de "Credenciales invalidas" (401) en menos de 60 segundos
alert http any any -> any any (msg:"Posible fuerza bruta: 3 inicios de sesion fallidos en 60s"; flow:established,to_client; http.stat_code; content:"401"; http.response_body; content:"Credenciales inv"; threshold:type threshold, track by_dst, count 3, seconds 60; classtype:attempted-user; sid:1000001; rev:1;)

# Alerta cuando la API bloquea a un cliente por exceso de peticiones
alert http any any -> any any (msg:"Cliente bloqueado por exceso de peticiones (429)"; flow:established,to_client; http.stat_code; content:"429"; classtype:attempted-dos; sid:1000002; rev:1;)
